# ============================================================
# Maskany — Production Environment Variables
# Copy this file to .env.production and fill in real values.
# Never commit .env.production to version control.
# ============================================================

# --- Database ---
# Full PostgreSQL connection string for the production database.
# Use a strong password and restrict network access to the API container only.
DATABASE_URL="postgresql://maskany:<PASSWORD>@postgres:5432/maskany?schema=public"

# Postgres service credentials (consumed by the postgres container in docker-compose.deploy.yml)
POSTGRES_USER=maskany
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=maskany

# --- API ---
NODE_ENV=production
PORT=3001

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-BYTE-HEX-SECRET>

# --- CORS ---
# Exact origin of the web frontend (no trailing slash). Used to restrict
# cross-origin credential requests to your own domain.
CORS_ORIGIN=https://maskany.com

# --- Twilio SMS ---
# Obtain from https://console.twilio.com → Account Info.
# The account SID starts with "AC".
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<AUTH_TOKEN>
# A Twilio phone number you own, in E.164 format.
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- SMTP Email ---
# Use a transactional email provider (Resend, SendGrid, Postmark, AWS SES).
# Port 587 (STARTTLS) is recommended. Use 465 for implicit TLS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<SMTP_API_KEY>
SMTP_FROM=noreply@maskany.com

# --- Uploads ---
# Absolute path inside the API container where uploaded files are stored.
# Mount a persistent volume at this path in docker-compose.deploy.yml.
UPLOADS_DIR=/app/uploads
