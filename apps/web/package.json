{
  "name": "@maskany/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Maskany mobile-first property listing web app",
  "scripts": {
    "dev": "next dev -p 5173 --webpack",
    "build": "next build --webpack",
    "start": "next start -p 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @maskany/api build && playwright test",
    "test:perf": "pnpm --filter @maskany/api build && playwright test --config=tests/performance/playwright.config.ts",
    "cap:add": "cap add",
    "cap:sync": "cap sync",
    "cap:open": "cap open"
  },
  "dependencies": {
    "@capacitor/push-notifications": "^8.1.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^16.8.1",
    "jsdom": "^25.0.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
