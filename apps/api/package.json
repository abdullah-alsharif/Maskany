{
  "name": "@maskany/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Maskany HTTP API — Express + Kysely on PostgreSQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:reset": "dotenv -e ../../.env -- tsx src/scripts/reset-db.ts",
    "db:migrate": "dotenv -e ../../.env -- tsx src/scripts/migrate.ts",
    "db:migrate:down": "dotenv -e ../../.env -- tsx src/scripts/migrate.ts down",
    "db:seed": "dotenv -e ../../.env -- tsx src/scripts/seed-cli.ts",
    "db:setup": "pnpm db:reset && pnpm db:migrate && pnpm db:seed",
    "db:embed": "dotenv -e ../../.env -- tsx src/scripts/embed-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.27.6",
    "multer": "1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.5",
    "twilio": "^5.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^2.1.9"
  }
}
