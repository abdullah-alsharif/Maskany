{
  "name": "@maskany/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Maskany HTTP API — Express + Kysely on PostgreSQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:reset": "dotenv -e ../../.env -- tsx src/scripts/reset-db.ts",
    "db:migrate": "dotenv -e ../../.env -- tsx src/scripts/migrate.ts",
    "db:migrate:down": "dotenv -e ../../.env -- tsx src/scripts/migrate.ts down",
    "db:seed": "dotenv -e ../../.env -- tsx src/scripts/seed-cli.ts",
    "db:setup": "pnpm db:reset && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.5",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
