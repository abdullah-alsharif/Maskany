{
  "name": "maskany",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first property listing platform with WhatsApp contact integration",
  "scripts": {
    "bootstrap": "bash scripts/setup.sh",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @maskany/api dev",
    "dev:web": "pnpm --filter @maskany/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "tsx scripts/acceptance-report.ts",
    "report:e2e": "tsx scripts/acceptance-report.ts --e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "bash scripts/test.sh",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:all": "bash scripts/test.sh && bash scripts/test-e2e.sh",
    "test:only": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test:only",
    "db:migrate": "schema-flow run --dir ./schema",
    "db:migrate:plan": "schema-flow plan --dir ./schema",
    "db:migrate:status": "schema-flow status --dir ./schema",
    "db:migrate:drift": "schema-flow drift --dir ./schema",
    "db:migrate:lint": "schema-flow lint --dir ./schema",
    "db:seed": "pnpm --filter @maskany/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:up:test": "docker compose -f docker-compose.test.yml up -d",
    "docker:down": "docker compose down",
    "docker:down:test": "docker compose -f docker-compose.test.yml down",
    "docker:down:all": "docker compose down && docker compose -f docker-compose.test.yml down",
    "ralph": "ralph loop --iterations 8 --verbose",
    "ralph:monitor": "ralph monitor --watch"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@smplcty/ralph": "^0.8.4",
    "@smplcty/schema-flow": "^0.3.7",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^11.0.0",
    "@lhci/cli": "^0.14.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/linux-arm",
      "@ffmpeg-installer/linux-arm64",
      "@ffmpeg-installer/linux-ia32",
      "@ffmpeg-installer/linux-x64",
      "@ffmpeg-installer/win32-ia32",
      "@ffmpeg-installer/win32-x64",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-arm",
      "@ffprobe-installer/linux-arm64",
      "@ffprobe-installer/linux-ia32",
      "@ffprobe-installer/linux-x64",
      "@ffprobe-installer/win32-ia32",
      "@ffprobe-installer/win32-x64",
      "sharp"
    ]
  }
}
