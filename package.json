{
  "name": "maskany",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first property listing platform with WhatsApp contact integration",
  "scripts": {
    "bootstrap": "bash scripts/setup.sh",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @maskany/api dev",
    "dev:web": "pnpm --filter @maskany/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "tsx scripts/acceptance-report.ts",
    "report:e2e": "tsx scripts/acceptance-report.ts --e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "bash scripts/test.sh",
    "test:e2e": "pnpm --filter @maskany/web test:e2e",
    "test:e2e:ui": "pnpm --filter @maskany/web test:e2e:ui",
    "test:e2e:debug": "pnpm --filter @maskany/web test:e2e:debug",
    "test:e2e:headed": "pnpm --filter @maskany/web test:e2e:headed",
    "test:e2e:up": "pnpm --filter @maskany/api test:e2e:up",
    "test:e2e:down": "pnpm --filter @maskany/api test:e2e:down",
    "test:all": "bash scripts/test.sh && bash scripts/test-e2e.sh",
    "test:only": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "db:reset": "pnpm --filter @maskany/api db:reset",
    "db:setup": "pnpm --filter @maskany/api db:setup",
    "db:migrate": "pnpm --filter @maskany/api db:migrate",
    "db:migrate:down": "pnpm --filter @maskany/api db:migrate:down",
    "db:seed": "pnpm --filter @maskany/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:up:test": "docker compose -f docker-compose.test.yml up -d",
    "docker:down": "docker compose down",
    "docker:down:test": "docker compose -f docker-compose.test.yml down",
    "docker:down:all": "docker compose down && docker compose -f docker-compose.test.yml down"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.14.0",
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
